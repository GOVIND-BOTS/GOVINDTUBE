APP_NAME=GOVIND TUBE API
ENVIRONMENT=development\n# Railway production values: ENVIRONMENT=production, MONGODB_URL=<MongoDB URI>, JWT_SECRET=<32+ random chars>\n# Set API_CORS_ORIGINS to the exact deployed website origin(s), comma-separated.\n# Railway persistent volume mount recommended at /app/uploads while local-disk uploads remain enabled.
MONGODB_URL=mongodb://localhost:27017
MONGODB_DATABASE=govind_tube
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
JWT_EXPIRE_MINUTES=10080
API_CORS_ORIGINS=http://localhost:3000
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=1024
NEXT_PUBLIC_API_URL=http://localhost:8000
EXPO_PUBLIC_API_URL=http://10.0.2.2:8000
EXPO_PUBLIC_PRIVACY_URL=
